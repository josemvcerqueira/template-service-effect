{
  "name": "ts-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/app/main.ts",
    "start": "bun src/app/main.ts",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc",
    "test": "bun test",
    "gate": "bash scripts/gate.sh",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install",
    "check:standard": "ip-standards-verify",
    "knip": "knip",
    "typecheck:effect": "effect-language-service diagnostics --project tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.4",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@interest-protocol/standards": "github:josemvcerqueira/standards#v0.4.1",
    "@types/bun": "^1.4.4",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-eslint": "^1.94.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.4"
}
